# Binaries
*.exe
*.dll
*.so
*.dylib
openclaw-installer
openclaw-updater

# Build directories (keep directory structure but ignore contents)
/dist/*
!/dist/.gitkeep
/build/*
!/build/.gitkeep

# Release packages (large binaries, keep only checksums)
/release/*.zip
/release/*.tar.gz

# USB deploy contents
/usb-deploy/*
!/usb-deploy/.gitkeep

# Test coverage
coverage.out
coverage.html
*.test

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp
tmp/
temp/
*.tmp

# Config (user-specific)
openclaw.json
config.yaml

# Dependencies (vendor if needed)
vendor/

# Go workspace
go.work
go.work.sum
