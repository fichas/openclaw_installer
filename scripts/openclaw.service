[Unit]
# OpenClaw 服务单元文件
# 安装: sudo cp openclaw.service /etc/systemd/system/
# 启用: sudo systemctl enable openclaw
# 启动: sudo systemctl start openclaw

Description=OpenClaw - Enterprise IM Integration Platform
Documentation=https://docs.openclaw.io
After=network-online.target
Wants=network-online.target

# 等待网络完全就绪
After=network.target

# 如果使用数据库，取消下面注释
# After=mysql.service postgresql.service

[Service]
# 服务类型
Type=simple

# 环境变量
Environment="OPENCLAW_HOME=/var/lib/openclaw"
Environment="OPENCLAW_CONFIG=/etc/openclaw/openclaw.json"
Environment="OPENCLAW_LOG_LEVEL=info"
Environment="GIN_MODE=release"

# 从环境文件加载额外配置（如果存在）
EnvironmentFile=-/etc/default/openclaw

# 工作目录
WorkingDirectory=/var/lib/openclaw

# 执行命令
ExecStart=/usr/local/bin/openclaw --config /etc/openclaw/openclaw.json

# 重启策略
Restart=on-failure
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# 优雅停止超时
TimeoutStopSec=30

# 用户和组
User=openclaw
Group=openclaw

# 资源限制
# 内存限制（根据实际需求调整）
# MemoryMax=512M
# MemorySwapMax=0

# CPU 限制
# CPUQuota=50%

# 文件描述符限制
LimitNOFILE=65535

# 进程数限制
LimitNPROC=4096

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openclaw /var/log/openclaw /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# 能力限制
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 系统调用过滤
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw

# 日志过滤（可选）
# LogFilterPatterns=~.*debug.*

[Install]
# 在多用户目标下启用
WantedBy=multi-user.target

# 别名（可选）
Alias=openclaw.service
